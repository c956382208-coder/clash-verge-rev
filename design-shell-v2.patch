+/* ==========================================================================
+   Clash Verge Dashboard - Pixel Perfect UI Stylesheet (Precision Absolute Grid)
+   ========================================================================== */
+
+*, *::before, *::after {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+  user-select: none;
+  -webkit-user-drag: none;
+}
+
+:root {
+  --primary-cyan: #00d2ff;
+  --primary-blue: #1868f8;
+  --neon-magenta: #e879f9;
+  --neon-green: #22c55e;
+  --neon-red: #ef4444;
+  --card-bg: rgba(6, 20, 44, 0.72);
+  --card-border: rgba(45, 120, 235, 0.32);
+  --card-inner-glow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
+  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
+}
+
+html, body {
+  width: 100%;
+  height: 100%;
+  background-color: #01040d;
+  font-family: var(--font-sans);
+  color: #ffffff;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.viewport-wrapper {
+  position: relative;
+  width: 1024px;
+  height: 683px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.window-shell {
+  position: absolute;
+  width: 1024px;
+  height: 683px;
+  background-color: #03081b;
+  border-radius: 12px;
+  overflow: hidden;
+  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.85), 0 0 40px rgba(24, 104, 248, 0.28);
+  border: 1px solid rgba(56, 189, 248, 0.28);
+}
+
+.window-bg {
+  position: absolute;
+  inset: 0;
+  background: url('../assets/bg_clean.jpg') no-repeat center center;
+  background-size: 100% 100%;
+  z-index: 1;
+  pointer-events: none;
+}
+
+.bg-stars-canvas-wrap {
+  position: absolute;
+  inset: 0;
+  opacity: 0.65;
+}
+
+#starsCanvas {
+  width: 100%;
+  height: 100%;
+  display: block;
+}
+
+/* ==========================================================================
+   顶栏 Header
+   ========================================================================== */
+.top-header {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 1024px;
+  height: 90px;
+  z-index: 10;
+  pointer-events: none;
+}
+
+.brand-area {
+  position: absolute;
+  left: 16px;
+  top: 15px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  cursor: pointer;
+  pointer-events: auto;
+}
+
+.brand-logo {
+  width: 30px;
+  height: 30px;
+  filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.75));
+  transition: transform 0.2s ease;
+}
+
+.brand-logo:hover {
+  transform: scale(1.06);
+}
+
+.brand-title {
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: 0.4px;
+  color: #ffffff;
+  line-height: 1.15;
+}
+
+.brand-sub {
+  font-size: 9px;
+  color: #7b93b2;
+  letter-spacing: 0.2px;
+}
+
+/* 中间主标语 (精准对准原图坐标 top: 36px) */
+.hero-slogan {
+  position: absolute;
+  left: 158px;
+  top: 36px;
+  pointer-events: none;
+}
+
+.slogan-main {
+  font-size: 20px;
+  font-weight: 700;
+  background: linear-gradient(180deg, #ffffff 15%, #dbeafe 100%);
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  letter-spacing: 0.8px;
+  text-shadow: 0 0 14px rgba(56, 189, 248, 0.4);
+}
+
+.slogan-sub {
+  font-size: 11px;
+  color: rgba(186, 215, 255, 0.72);
+  letter-spacing: 1.5px;
+  margin-top: 4px;
+}
+
+/* 右上角控制栏 */
+.top-controls {
+  position: absolute;
+  right: 14px;
+  top: 12px;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  pointer-events: auto;
+}
+
+.search-box {
+  width: 180px;
+  height: 28px;
+  background: rgba(9, 22, 48, 0.75);
+  border: 1px solid rgba(56, 189, 248, 0.28);
+  border-radius: 14px;
+  display: flex;
+  align-items: center;
+  padding: 0 10px;
+  transition: all 0.2s ease;
+}
+
+.search-box:focus-within {
+  border-color: rgba(56, 189, 248, 0.65);
+  box-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
+  background: rgba(12, 28, 60, 0.9);
+}
+
+.search-icon {
+  width: 14px;
+  height: 14px;
+  color: #64748b;
+  margin-right: 6px;
+  flex-shrink: 0;
+}
+
+.search-box input {
+  width: 100%;
+  background: transparent;
+  border: none;
+  outline: none;
+  font-size: 11px;
+  color: #ffffff;
+}
+
+.search-box input::placeholder {
+  color: #5c749a;
+}
+
+.theme-toggle {
+  display: flex;
+  align-items: center;
+  background: rgba(9, 22, 48, 0.75);
+  border: 1px solid rgba(56, 189, 248, 0.28);
+  border-radius: 14px;
+  padding: 2px;
+  cursor: pointer;
+}
+
+.theme-option {
+  width: 22px;
+  height: 22px;
+  border-radius: 50%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #64748b;
+  transition: all 0.2s ease;
+}
+
+.theme-option svg {
+  width: 13px;
+  height: 13px;
+}
+
+.theme-option.active {
+  background: rgba(56, 189, 248, 0.22);
+  color: #facc15;
+  box-shadow: 0 0 8px rgba(250, 204, 21, 0.45);
+}
+
+.icon-btn {
+  position: relative;
+  width: 28px;
+  height: 28px;
+  background: transparent;
+  border: none;
+  color: #94a9cb;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  border-radius: 6px;
+  transition: all 0.2s ease;
+}
+
+.icon-btn:hover {
+  background: rgba(255, 255, 255, 0.08);
+  color: #ffffff;
+}
+
+.icon-btn svg {
+  width: 16px;
+  height: 16px;
+}
+
+.notice-badge {
+  position: absolute;
+  top: 4px;
+  right: 4px;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background-color: #ef4444;
+  box-shadow: 0 0 6px #ef4444;
+}
+
+.window-actions {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  margin-left: 6px;
+}
+
+.win-btn {
+  width: 28px;
+  height: 26px;
+  background: transparent;
+  border: none;
+  color: #94a9cb;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 4px;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.win-btn svg {
+  width: 10px;
+  height: 10px;
+}
+
+.win-btn:hover {
+  background: rgba(255, 255, 255, 0.1);
+  color: #ffffff;
+}
+
+.win-close:hover {
+  background: #ef4444;
+  color: #ffffff;
+}
+
+/* ==========================================================================
+   左侧边栏 (Sidebar)
+   ========================================================================== */
+.sidebar {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: 142px;
+  height: 683px;
+  z-index: 10;
+  pointer-events: none;
+}
+
+.nav-menu {
+  position: absolute;
+  left: 13px;
+  top: 66px;
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  pointer-events: auto;
+}
+
+.nav-item {
+  width: 116px;
+  height: 35px;
+  background: transparent;
+  border: none;
+  border-radius: 8px;
+  display: flex;
+  align-items: center;
+  padding: 0 12px;
+  gap: 12px;
+  color: rgba(200, 220, 248, 0.72);
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 500;
+  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.nav-item:hover {
+  background: rgba(30, 70, 140, 0.28);
+  color: #ffffff;
+  transform: translateX(2px);
+}
+
+.nav-icon {
+  width: 18px;
+  height: 18px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.nav-icon svg {
+  width: 18px;
+  height: 18px;
+}
+
+.nav-item.active {
+  background: linear-gradient(90deg, #1868f8 0%, #0284c7 100%);
+  color: #ffffff;
+  font-weight: 600;
+  box-shadow: 0 0 16px rgba(24, 104, 248, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.3);
+}
+
+.nav-item.active .nav-icon {
+  filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.6));
+}
+
+.status-pill {
+  position: absolute;
+  left: 13px;
+  top: 644px;
+  width: 116px;
+  height: 24px;
+  background: rgba(5, 16, 38, 0.7);
+  border: 1px solid rgba(34, 197, 94, 0.25);
+  border-radius: 12px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  font-size: 11px;
+  pointer-events: auto;
+}
+
+.ver-text {
+  color: #7b93b2;
+}
+
+.live-dot {
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background-color: #22c55e;
+  box-shadow: 0 0 8px #22c55e;
+  animation: pulse-dot 2s infinite ease-in-out;
+}
+
+@keyframes pulse-dot {
+  0%, 100% { opacity: 1; transform: scale(1); }
+  50% { opacity: 0.6; transform: scale(0.85); }
+}
+
+.live-text {
+  color: #22c55e;
+  font-weight: 500;
+}
+
+/* ==========================================================================
+   卡片通用样式
+   ========================================================================== */
+.card {
+  position: absolute;
+  background: var(--card-bg);
+  backdrop-filter: blur(18px);
+  -webkit-backdrop-filter: blur(18px);
+  border: 1px solid var(--card-border);
+  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), var(--card-inner-glow);
+  border-radius: 14px;
+  z-index: 10;
+  transition: border-color 0.2s ease, box-shadow 0.2s ease;
+}
+
+.card:hover {
+  border-color: rgba(56, 189, 248, 0.48);
+  box-shadow: 0 10px 36px rgba(0, 0, 0, 0.6), 0 0 14px rgba(56, 189, 248, 0.18), var(--card-inner-glow);
+}
+
+.card-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+.card-title-group {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.card-title {
+  font-size: 13.5px;
+  font-weight: 600;
+  color: #ffffff;
+}
+
+.badge-status-green, .badge-status-connected {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  padding: 2px 8px;
+  background: rgba(34, 197, 94, 0.12);
+  border: 1px solid rgba(34, 197, 94, 0.35);
+  border-radius: 10px;
+  font-size: 11px;
+  color: #4ade80;
+}
+
+.status-dot {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background-color: #22c55e;
+  box-shadow: 0 0 6px #22c55e;
+}
+
+.btn-refresh {
+  height: 25px;
+  padding: 0 10px;
+  background: linear-gradient(90deg, #1868f8 0%, #0284c7 100%);
+  border: 1px solid rgba(56, 189, 248, 0.4);
+  border-radius: 12.5px;
+  color: #ffffff;
+  font-size: 11px;
+  font-weight: 500;
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  cursor: pointer;
+  box-shadow: 0 0 10px rgba(24, 104, 248, 0.4);
+  transition: all 0.2s ease;
+}
+
+.btn-refresh:hover {
+  filter: brightness(1.15);
+  box-shadow: 0 0 14px rgba(24, 104, 248, 0.7);
+}
+
+.btn-refresh .refresh-icon {
+  width: 12px;
+  height: 12px;
+  transition: transform 0.6s ease;
+}
+
+.btn-refresh.rotating .refresh-icon {
+  transform: rotate(360deg);
+}
+
+.btn-more, .btn-circle-more {
+  width: 25px;
+  height: 25px;
+  border-radius: 12.5px;
+  background: rgba(15, 32, 64, 0.6);
+  border: 1px solid rgba(56, 189, 248, 0.25);
+  color: #94a9cb;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  cursor: pointer;
+  font-size: 12px;
+  line-height: 1;
+  transition: all 0.2s ease;
+}
+
+.btn-more:hover, .btn-circle-more:hover {
+  background: rgba(20, 45, 90, 0.85);
+  color: #ffffff;
+  border-color: rgba(56, 189, 248, 0.5);
+}
+
+/* ==========================================================================
+   卡片 1：总订阅 (Precision Absolute: 153, 100, 538, 279)
+   ========================================================================== */
+.card-subscription {
+  left: 153px;
+  top: 100px;
+  width: 538px;
+  height: 279px;
+  padding: 10px 14px 8px 14px;
+  display: flex;
+  flex-direction: column;
+  justify-content: space-between;
+}
+
+.cloud-icon svg {
+  width: 17px;
+  height: 17px;
+  color: #38bdf8;
+  filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6));
+}
+
+.traffic-summary {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  margin-top: 2px;
+}
+
+.traffic-numbers {
+  display: flex;
+  align-items: baseline;
+  gap: 4px;
+}
+
+.traffic-used {
+  font-size: 32px;
+  font-weight: 700;
+  color: #ffffff;
+  letter-spacing: -0.5px;
+}
+
+.traffic-unit {
+  font-size: 14px;
+  font-weight: 600;
+  color: #cbd5e1;
+}
+
+.traffic-divider {
+  font-size: 14px;
+  color: #64748b;
+  margin: 0 2px;
+}
+
+.traffic-total {
+  font-size: 14px;
+  color: #94a9cb;
+}
+
+.traffic-percentage {
+  font-size: 23px;
+  font-weight: 700;
+  color: #00d2ff;
+  text-shadow: 0 0 10px rgba(0, 210, 255, 0.55);
+}
+
+.progress-bar-wrap {
+  width: 100%;
+  height: 6px;
+  background: rgba(12, 28, 58, 0.85);
+  border-radius: 3px;
+  overflow: hidden;
+  position: relative;
+  margin-top: 2px;
+}
+
+.progress-bar-fill {
+  height: 100%;
+  background: linear-gradient(90deg, #1060eb 0%, #00d2ff 100%);
+  border-radius: 3px;
+  position: relative;
+  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.progress-glow {
+  position: absolute;
+  right: 0;
+  top: 0;
+  bottom: 0;
+  width: 10px;
+  box-shadow: 0 0 8px #00d2ff;
+}
+
+.subscription-meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 11px;
+  color: #8da4c4;
+  margin-top: 1px;
+}
+
+.expire-info strong {
+  color: #ffffff;
+  font-weight: 600;
+}
+
+.expire-date {
+  color: #64748b;
+  margin-left: 4px;
+}
+
+.resource-count {
+  color: #8da4c4;
+}
+
+.sub-list {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin-top: 1px;
+}
+
+.sub-item {
+  height: 23.5px;
+  display: flex;
+  align-items: center;
+  padding: 0 6px;
+  border-radius: 5px;
+  font-size: 11px;
+  color: #c0d4ec;
+  transition: background 0.15s ease;
+}
+
+.sub-item:hover {
+  background: rgba(30, 75, 150, 0.28);
+}
+
+.sub-brand {
+  width: 98px;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.sub-name {
+  font-size: 11.5px;
+  color: #e2e8f0;
+  white-space: nowrap;
+}
+
+.sub-usage {
+  width: 108px;
+  font-size: 11px;
+  color: #94a9cb;
+}
+
+.sub-prog-wrap {
+  width: 48px;
+  height: 4px;
+  background: rgba(15, 32, 64, 0.85);
+  border-radius: 2px;
+  overflow: hidden;
+  margin-right: 8px;
+}
+
+.sub-prog-bar {
+  height: 100%;
+  background: linear-gradient(90deg, #1868f8, #00d2ff);
+  border-radius: 2px;
+}
+
+.sub-percent {
+  width: 32px;
+  font-size: 11px;
+  color: #cbd5e1;
+}
