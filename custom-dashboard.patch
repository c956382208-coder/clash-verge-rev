+
+  min-height: 100%;
+  padding: 4px;
+  color: var(--dashboard-text);
+  background:
+    radial-gradient(circle at 6% 4%, rgb(133 105 255 / 27%), transparent 34%),
+    radial-gradient(circle at 96% 13%, rgb(42 223 234 / 18%), transparent 31%),
+    linear-gradient(135deg, #0b0e1b 0%, #11152a 45%, #0e1324 100%);
+
+  .MuiTypography-root {
+    color: inherit;
